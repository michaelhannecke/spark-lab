#!/usr/bin/env bash
# newenv <name> [pip-package ...]
#
# Create a throwaway per-project Python env inside the container and register it
# as a JupyterLab kernel. Inherits the image's torch/CUDA stack via
# --system-site-packages, so you are NOT re-downloading a 3 GB torch wheel that
# would probably be built for the wrong arch anyway.

set -euo pipefail

VENV_ROOT=${VENV_ROOT:-/opt/venvs}

if [[ $# -lt 1 ]]; then
    echo "usage: newenv <name> [pip-package ...]" >&2
    exit 64
fi

NAME=$1
shift

if [[ ! $NAME =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "newenv: invalid env name '$NAME'" >&2
    exit 64
fi

VENV="$VENV_ROOT/$NAME"

if [[ -d $VENV ]]; then
    echo "newenv: reusing existing env $VENV"
else
    echo "newenv: creating $VENV (system site-packages inherited)"
    # --seed puts pip inside the venv. We need pip specifically -- see below.
    uv venv --seed --system-site-packages --python "$(command -v python3)" "$VENV"
fi

# IMPORTANT: install with the venv's own pip, NOT `uv pip install`.
#
# `uv venv --system-site-packages` makes the image's torch/CUDA stack VISIBLE at
# runtime, but `uv pip install` does not consider inherited system site-packages
# when RESOLVING dependencies -- it plans against the venv's own site-packages
# only. So `uv pip install transformer-lens` decides torch is missing and pulls
# a multi-gigabyte generic aarch64 wheel from PyPI, which then shadows the
# NGC build. That wheel has no sm_121 kernels, so you end up with a slower,
# broken torch that took twenty minutes to install.
#
# pip resolves against everything on sys.path, sees the image's torch, and
# treats the requirement as satisfied. Verify the difference yourself with:
#   uv pip install --dry-run pandas          # plans to download numpy
#   $VENV/bin/python -m pip install --dry-run pandas   # installs nothing
#
# No --quiet: a dependency tree like transformer-lens can take minutes, and
# silence is indistinguishable from a hang.
"$VENV/bin/python" -m pip install ipykernel "$@"

"$VENV/bin/python" -m ipykernel install \
    --user \
    --name "$NAME" \
    --display-name "Python ($NAME)"

echo
echo "newenv: kernel '$NAME' registered."
echo "        Reload the JupyterLab tab, then pick 'Python ($NAME)' as the kernel."
echo "        Install more into it from a notebook cell with:"
echo "          !$VENV/bin/python -m pip install <pkg>"
