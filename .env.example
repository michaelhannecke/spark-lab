# Copy to .env and edit.  cp .env.example .env

# --- Base image ---------------------------------------------------------
# Must be an aarch64 image with CUDA 13 / sm_121 support for GB10.
# 25.10-py3 is the tag NVIDIA points DGX Spark users at; check the NGC catalog
# for a newer one and pin it explicitly rather than tracking :latest.
BASE_IMAGE=nvcr.io/nvidia/pytorch:25.10-py3

# --- Auth ---------------------------------------------------------------
# Generate one:  openssl rand -hex 32
JUPYTER_TOKEN=CHANGE_ME

# --- Network ------------------------------------------------------------
# 0.0.0.0 = reachable from the Mac Studio over the LAN (token is your only gate)
# 127.0.0.1 = localhost only; reach it with an SSH tunnel from the Mac
BIND_ADDR=0.0.0.0
# 8888 avoids the DGX Dashboard (11000) and its per-user JupyterLab ports.
HOST_PORT=8888

# --- Model cache --------------------------------------------------------
# Host directory bind-mounted at /opt/caches/hf (HF_HOME), so checkpoints are
# downloaded once and shared with every other HuggingFace-based container on
# this node (vLLM, TGI, SGLang, ...). Ollama and NIM keep their own stores and
# will NOT share this.
#
# Create it before the first `docker compose up`, owned by DEV_UID:DEV_GID
# below -- Docker creates a missing bind source as root:root and downloads then
# fail with a permission error:
#   sudo mkdir -p /srv/hf-cache
#   sudo chown 1000:1000 /srv/hf-cache
#   sudo chmod 2775 /srv/hf-cache      # setgid: new files keep the group
#
# Already have a populated cache in the `caches` volume? Move it over first:
#   docker compose down
#   sudo rsync -a /var/lib/docker/volumes/spark-lab_caches/_data/hf/ /srv/hf-cache/
# Keep it on local NVMe: huggingface_hub coordinates concurrent downloads with
# flock, which is unreliable over NFS.
HF_CACHE_DIR=/srv/hf-cache

# --- File ownership -----------------------------------------------------
# Must match the host user that owns ./notebooks, or bind-mounted files come
# back root-owned.  Check with:  id -u ; id -g
DEV_UID=1000
DEV_GID=1000
